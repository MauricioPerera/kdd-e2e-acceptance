{
  "protected": [
    ".gitattributes",
    ".github/workflows/acceptance.yml",
    ".gitignore",
    "acceptance.json",
    "e2e.config.ts",
    "knowledge/architecture.md",
    "knowledge/contracts/report-validation.md",
    "knowledge/contracts/todo-domain.md",
    "knowledge/contracts/todo-ui.md",
    "knowledge/index.md",
    "LICENSE",
    "NOTICE",
    "package-lock.json",
    "package.json",
    "schema/report-v1.schema.json",
    "scripts/approval.mjs",
    "scripts/kdd.mjs",
    "scripts/probe-board.mjs",
    "scripts/setup-kdd.mjs",
    "scripts/validate-kdd.mjs",
    "scripts/verify-quality.mjs",
    "src/git.mjs",
    "src/oracle.mjs",
    "src/report-validator.mjs",
    "src/subprocess.mjs",
    "tests/approval.test.mjs",
    "tests/domain.test.mjs",
    "tests/environment.test.mjs",
    "tests/fixtures/passed.report.json",
    "tests/mutations.test.mjs",
    "tests/report.adversarial.test.mjs",
    "tests/report.functional.test.mjs",
    "tests/subprocess.test.mjs",
    "tests/support/domain-oracle.mjs",
    "tests/support/fixtures.mjs",
    "tests/todos.e2e.ts",
    "tests/ui-oracle.test.mjs",
    "tooling.json"
  ],
  "implementation": [
    "example/todo-model.mjs",
    "example/client.mjs",
    "example/index.html",
    "example/server.mjs"
  ],
  "pm": [
    "README.md",
    "docs/REVIEW.md",
    "docs/VALIDATION.md",
    "specs/CONTRACT-01-acceptance.md"
  ],
  "required_kinds": [
    "functional",
    "adversarial",
    "ui"
  ],
  "checks": [
    {
      "name": "kdd-metadata",
      "kind": "structural",
      "argv": [
        "node",
        "scripts/validate-kdd.mjs",
        "--metadata-only"
      ],
      "timeout": 60
    },
    {
      "name": "functional",
      "kind": "functional",
      "argv": [
        "node",
        "--test",
        "tests/report.functional.test.mjs",
        "tests/domain.test.mjs",
        "tests/subprocess.test.mjs",
        "tests/approval.test.mjs",
        "tests/environment.test.mjs"
      ],
      "timeout": 60
    },
    {
      "name": "adversarial",
      "kind": "adversarial",
      "argv": [
        "node",
        "--test",
        "tests/report.adversarial.test.mjs",
        "tests/mutations.test.mjs"
      ],
      "timeout": 60
    },
    {
      "name": "ui",
      "kind": "ui",
      "argv": [
        "node",
        "--test",
        "tests/ui-oracle.test.mjs"
      ],
      "timeout": 60
    }
  ]
}
